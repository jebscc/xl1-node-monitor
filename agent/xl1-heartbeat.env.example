# Agent configuration — EXAMPLE
#
# Every value below is made up. Replace them; do not put this into service
# as-is.
#
#   sudo cp xl1-heartbeat.env.example /etc/xl1-heartbeat.env
#   sudo nano /etc/xl1-heartbeat.env
#   sudo chmod 600 /etc/xl1-heartbeat.env
#
# This file holds the ingest secret. It is NOT the XL1 mnemonic — the agent
# never reads, needs, or transmits your wallet phrase.
#
# TWO RULES THAT WILL BITE YOU
#
# 1. Setting a variable to nothing is NOT the same as leaving it out.
#    `XL1_HEIGHT_URL=` overrides the default with an empty string and turns
#    that feature off. Delete or comment out the line to get the default.
#    Everything optional below is therefore commented out, not blanked.
#
# 2. Quote any value containing spaces. systemd does not need the quotes, but
#    the one-shot test in the README sources this file with `.`, and an
#    unquoted `NODE_LABEL=My XL1 Node` makes the shell try to run `XL1`.
#
# A working file can be as short as the required section below. That is the
# normal case, not a cut-down one.

# --- required ---------------------------------------------------------------

# Your receiver's URL. No trailing slash. Use https for anything leaving the
# local network — the token below travels with every request.
BACKEND_URL=https://xl1-monitor.example.com

# Must match NODE_HEARTBEAT_TOKEN in the receiver's environment, exactly.
#
# Deliberately not a realistic-looking value: a working-looking token in a
# public example is one somebody forgets to change. Generate your own, which
# will be 64 hex characters:
#
#   openssl rand -hex 32
NODE_HEARTBEAT_TOKEN=CHANGE-ME-generate-with-openssl-rand-hex-32

# --- identity (recommended) -------------------------------------------------
# Defaults work, but every node then reports as the same thing, which gets
# confusing the moment you run two.

NODE_ID=node-01
NODE_LABEL="Basement Pi"
NODE_ROLE=producer
NODE_NETWORK=sequence

# --- everything below is optional -------------------------------------------
# Each is shown with the value the agent uses when the line is absent.
# Uncomment only what you actually want to change.

# The image tag your node runs, as `docker ps` reports it. Change this if
# yours differs — it is how the container is found.
# XL1_IMAGE=xl1:local

# Pin the container by exact name instead of discovering it by image tag.
# Empty is a genuine setting here: it means "discover it".
# XL1_CONTAINER=

# Where the node serves health inside the container.
# XL1_HEALTH_PORT=9099

# Set ONLY if you published the health port to the host
# (docker run -p 127.0.0.1:9099:9099). Left unset, the agent reads health
# through `docker exec` and needs no published ports at all.
# XL1_HEALTH_URL=http://127.0.0.1:9099/livez

# Seconds between heartbeats. The receiver marks a node OFFLINE after three
# missed beats, so raising this makes an outage take longer to notice.
# HEARTBEAT_INTERVAL=30

# Seconds to wait for the receiver to answer. Generous: a free-tier host that
# has spun down can take 30-60s to wake.
# HEARTBEAT_TIMEOUT=60

# --- block production counts (optional) -------------------------------------
#
# These already point at localhost:8090, so if you run a service there they
# work with no configuration at all. Setting them empty switches counting OFF.
#
# The service is not included in this repository — see "block production
# counts" in the README for the endpoint contract it has to satisfy.

# XL1_HEIGHT_URL=http://127.0.0.1:8090/block-height
# XL1_PRODUCER_URL=http://127.0.0.1:8090/producer

# Which networks to ask for heights.
# XL1_HEIGHT_NETWORKS=sequence,mainnet

# Seconds between production scans. Scanning is the expensive call, so it runs
# far less often than the heartbeat.
# XL1_PRODUCER_INTERVAL=900

# Blocks to scan on the very first run, before a cursor exists.
# XL1_PRODUCER_WINDOW=200

# Blocks per history chunk, walking backwards toward genesis. Set 0 to disable
# backfill and count only from today onward.
# XL1_BACKFILL_CHUNK=50000

# The address whose blocks are counted. Normally leave this out entirely: the
# agent reads it from the running container's environment. Set it only if that
# discovery fails. Forty hex characters, with or without a 0x prefix.
# XL1_REWARD_ADDRESS=1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d

# --- rarely changed ---------------------------------------------------------

# Substring of the node's entrypoint command, used as a last-resort way to
# identify the container when the image tag no longer matches — which happens
# during an image promotion, when the old tag is briefly gone.
# XL1_COMMAND_HINT=/opt/xl1/

# Where to look up the newest published CLI version, for the "update
# available" comparison.
#
# Setting this empty switches version checking off completely — both the
# lookup and the read from the container. That read is a `docker exec`, so
# turning it off (together with XL1_HEALTH_URL above) leaves the agent making
# only read-only Docker calls. See "Reducing what that access can do" in the
# README.
# XL1_CLI_REGISTRY=https://registry.npmjs.org/@xyo-network/xl1-cli/latest

# Seconds between version checks. Four times a day is plenty for something
# that changes every few weeks.
# XL1_CLI_CHECK_INTERVAL=21600

# --- eligibility, logs, and supervision (all optional) ------------------------

# How far back to grep the container log for the node's own reason it cannot
# produce ("insufficient stake", "has no balance"). Long enough to survive a
# quiet period, short enough that a resolved problem stops being reported.
# XL1_ELIGIBILITY_WINDOW=20m

# How many recent log lines to report, so an operator can see what the node is
# saying without reaching the machine. The agent over-fetches and trims, so
# blank lines in the output do not shrink the count below this.
# XL1_LOG_TAIL_LINES=20

# The timer that rebuilds the node image, if you installed the one in this
# repo. Empty by default: a unit name that does not exist would be reported as
# a failing reader when nothing is actually wrong.
# XL1_REBUILD_TIMER=xl1-image-rebuild.timer

# The systemd unit managing the producer container, if one does. Empty by
# default for the same reason.
# XL1_PRODUCER_UNIT=xl1-producer.service
