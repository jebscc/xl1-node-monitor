# Receiver configuration — EXAMPLE
#
# Every value below is made up. Replace them; do not deploy this as-is.
#
# On a platform host (Render, Fly, Railway…) these go in the service's
# environment settings, NOT in a file in the repository. This example exists to
# show you what to set there.
#
# To run locally instead:
#
#   cp .env.example .env        # .env is gitignored
#   set -a; . ./.env; set +a
#   uvicorn app:app --host 0.0.0.0 --port 8000

# --- required ---------------------------------------------------------------

# The shared secret. Must match NODE_HEARTBEAT_TOKEN on every node machine
# reporting to this receiver.
#
# This is the only thing preventing a stranger from posting fake heartbeats,
# so it is deliberately not a working-looking value here — an example token
# that looks real is one somebody forgets to replace. Generate your own:
#
#   openssl rand -hex 32
NODE_HEARTBEAT_TOKEN=CHANGE-ME-generate-with-openssl-rand-hex-32

# --- storage ----------------------------------------------------------------

# Where the SQLite file is written. Relative paths are relative to the working
# directory the app starts in.
#
# Note the same rule as the agent's file: setting a variable to nothing is not
# the same as leaving it out. `DB_PATH=` would make the app try to open a file
# with no name. Delete the line to get the default.
#
# IMPORTANT on platform hosts: the default lands on a filesystem that is wiped
# on every deploy and restart. Nothing errors — the database is recreated and
# the service carries on — but the lifetime block total and the counting cursor
# are gone. Point this at a persistent disk if you want those to survive:
#
#   DB_PATH=/data/nodes.db
DB_PATH=nodes.db

# --- tuning -----------------------------------------------------------------

# Seconds of silence before a node is reported OFFLINE. The default is three
# missed heartbeats at the agent's default 30s interval. Raise both together if
# you widen one.
HEARTBEAT_TTL_SECONDS=90

# --- notes ------------------------------------------------------------------
#
# PORT is NOT read by this app. Platform hosts assign a port and expect the
# process to bind to it, which is done in the start command rather than here:
#
#   uvicorn app:app --host 0.0.0.0 --port $PORT
#
# Hard-coding a port there is the usual reason a deploy is marked unhealthy
# while the application itself started perfectly.
