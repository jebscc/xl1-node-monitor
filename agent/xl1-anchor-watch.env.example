# /etc/xl1-anchor-watch.env -- how THIS machine brings its anchor service up.
#
# There is no default command on purpose. The Pi 4 is compose-managed with a
# hand-written tailnet override; the Pi 3 is wizard-built with plain
# `docker run`. Reconstructing either one from the other's flags is how the
# Pi 4 nearly lost the second publish that /chain depends on, so each machine
# states its own and the watchdog refuses to guess.

# --- Pi 4, XL1BlockProducer (compose + the tailnet override) ----------------
# ANCHOR_CONTAINER=xl1-service-anchor-1
# ANCHOR_WANT_PORTS=2
# ANCHOR_REQUIRE_ADDR=<this machine's tailnet address>
# ANCHOR_UP_CMD='cd /opt/MyAdventureWebsite/xl1-service && docker compose -f docker-compose.pi.yml -f ~/xl1-deploy/docker-compose.tailnet.yml up -d --force-recreate'

# --- a wizard-built node (loopback only) ------------------------------------
# ANCHOR_CONTAINER=xl1-service-anchor-1
# ANCHOR_WANT_PORTS=1
# ANCHOR_UP_CMD='/opt/xl1-node-monitor/bootstrap-pi.sh --node-id <id>'

# --- tuning, all optional ---------------------------------------------------
# ANCHOR_HEALTH_URL=http://127.0.0.1:8090/health
# ANCHOR_FAIL_STREAK=3          # consecutive bad checks before acting
# ANCHOR_RECREATE_COOLDOWN=3600 # at most one recreate an hour
# ANCHOR_ADDR_WAIT=300          # seconds to wait for ANCHOR_REQUIRE_ADDR
