# Agent configuration — EXAMPLE
#
# Every value below is made up. Replace them; do not copy this file into
# service as-is.
#
#   sudo cp xl1-heartbeat.env.example /etc/xl1-heartbeat.env
#   sudo nano /etc/xl1-heartbeat.env
#   sudo chmod 600 /etc/xl1-heartbeat.env
#
# This file holds the ingest secret. It is NOT the XL1 mnemonic — the agent
# never reads, needs, or transmits your wallet phrase.
#
# Quote any value containing spaces. systemd's EnvironmentFile does not need
# quotes, but the one-shot test in the README sources this file with `.`, and
# an unquoted `NODE_LABEL=My XL1 Node` makes the shell try to run `XL1`.

# --- required ---------------------------------------------------------------

# Your receiver's URL. No trailing slash. Use https for anything that leaves
# the local network — the token below travels with every request.
BACKEND_URL=https://xl1-monitor.example.com

# Must match NODE_HEARTBEAT_TOKEN in the receiver's environment, exactly.
#
# Deliberately not a realistic-looking value: a working-looking token in a
# public example is one somebody forgets to change. Generate your own, which
# will be 64 hex characters:
#
#   openssl rand -hex 32
NODE_HEARTBEAT_TOKEN=CHANGE-ME-generate-with-openssl-rand-hex-32

# The image tag your node runs, exactly as `docker ps` reports it. Used to find
# the container when XL1_CONTAINER is empty.
XL1_IMAGE=xl1:local

# --- identity ---------------------------------------------------------------
# How this node is named on the status page. Any values you like.

NODE_ID=node-01
NODE_LABEL="Basement Pi"
NODE_ROLE=producer
NODE_NETWORK=sequence

# --- container discovery ----------------------------------------------------

# Pin the container by exact name. Leave empty to discover it by image tag,
# which survives the random names `docker run` assigns without --name.
XL1_CONTAINER=

# Where the node serves its health check inside the container.
XL1_HEALTH_PORT=9099

# Only set this if you published the health port to the host
# (docker run -p 127.0.0.1:9099:9099). Left empty, the agent reads health
# through `docker exec` and needs no published ports at all.
#   example: http://127.0.0.1:9099/livez
XL1_HEALTH_URL=

# --- timing -----------------------------------------------------------------

# Seconds between heartbeats. The receiver marks a node OFFLINE after three
# missed beats, so raising this makes an outage take longer to notice.
HEARTBEAT_INTERVAL=30

# --- block production counts (optional) -------------------------------------
#
# Both are empty by default, and the agent works fine without them — it simply
# reports no chain heights and no production figures.
#
# Filling them in requires a service you provide that can read the chain
# through @xyo-network/xl1-sdk. See "block production counts" in the README for
# the exact endpoint contract. Typical values once you are running one:
#
#   XL1_HEIGHT_URL=http://127.0.0.1:8090/block-height
#   XL1_PRODUCER_URL=http://127.0.0.1:8090/producer

XL1_HEIGHT_URL=
XL1_PRODUCER_URL=

# Which networks to ask for heights.
XL1_HEIGHT_NETWORKS=sequence,mainnet

# Seconds between production scans. Scanning is the expensive call, so it runs
# far less often than the heartbeat.
XL1_PRODUCER_INTERVAL=900

# Blocks to scan on the very first run, before a cursor exists.
XL1_PRODUCER_WINDOW=200

# Blocks per history chunk, walking backwards toward genesis. Set 0 to disable
# backfill and count only from today onward.
XL1_BACKFILL_CHUNK=50000

# The address whose blocks are counted. Normally leave this empty: the agent
# reads it from the running container's environment. Set it only if that
# discovery fails. Forty hex characters, with or without a 0x prefix.
#   example: 1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d
XL1_REWARD_ADDRESS=

# --- rarely changed ---------------------------------------------------------
# Shown with their defaults so you know they exist. Leave them commented out
# unless you have a reason.

# Substring of the node's entrypoint command, used as a last-resort way to
# identify the container when the image tag no longer matches — which happens
# during an image promotion, when the old tag is briefly gone.
# XL1_COMMAND_HINT=/opt/xl1/

# Seconds to wait for the receiver to answer. Generous by default: a free-tier
# host that has spun down can take 30-60s to wake.
# HEARTBEAT_TIMEOUT=60

# Where to look up the newest published CLI version, for the "update
# available" comparison. Set empty to skip the outbound lookup entirely.
# XL1_CLI_REGISTRY=https://registry.npmjs.org/@xyo-network/xl1-cli/latest

# Seconds between version checks. Four times a day is plenty for something
# that changes every few weeks.
# XL1_CLI_CHECK_INTERVAL=21600
