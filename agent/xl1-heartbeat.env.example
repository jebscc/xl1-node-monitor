# Copy to /etc/xl1-heartbeat.env on the Pi, then: sudo chmod 600 /etc/xl1-heartbeat.env
#
# This file holds the ingest secret. It is NOT the XL1 mnemonic -- the agent
# never reads, needs, or transmits your wallet phrase.

# Where to POST. Your Render backend.
BACKEND_URL=https://your-receiver.example.com

# Must match NODE_HEARTBEAT_TOKEN in the backend environment.
# Generate with: openssl rand -hex 32
NODE_HEARTBEAT_TOKEN=replace-me

# How this node is identified and labelled on the dashboard.
NODE_ID=pi-producer-01
NODE_LABEL=Raspberry Pi 5
NODE_ROLE=producer
NODE_NETWORK=sequence

# Container discovery. Leave XL1_CONTAINER empty to auto-discover by image,
# which survives the random names `docker run` assigns without --name.
XL1_CONTAINER=
XL1_IMAGE=xl1:local
XL1_HEALTH_PORT=9099

# Only set this if you have published the health port to the Pi's loopback
# (docker run -p 127.0.0.1:9099:9099). Left empty, the agent uses `docker exec`
# and needs no published ports at all.
XL1_HEALTH_URL=

# Local xl1-service that answers /block-height (see xl1-service/docker-compose.pi.yml).
# Set empty to disable chain-height reporting entirely.
XL1_HEIGHT_URL=http://127.0.0.1:8090/block-height

HEARTBEAT_INTERVAL=30
