# Copy to /etc/xl1-heartbeat.env, then: sudo chmod 600 /etc/xl1-heartbeat.env
#
# This file holds the ingest secret. It is NOT the XL1 mnemonic -- the agent
# never reads, needs, or transmits your wallet phrase.
#
# Quote any value containing spaces. systemd's EnvironmentFile does not need
# quotes, but the one-shot test in the README sources this file with `.`, and
# an unquoted `NODE_LABEL=My XL1 Node` makes the shell try to run `XL1`.

# --- required ---------------------------------------------------------------

# Where to POST. Your receiver, reachable from this machine.
BACKEND_URL=https://your-receiver.example.com

# Must match NODE_HEARTBEAT_TOKEN in the receiver's environment.
# Generate with: openssl rand -hex 32
NODE_HEARTBEAT_TOKEN=replace-me

# The image tag your node runs, as shown by `docker ps`. Used to find the
# container when XL1_CONTAINER is empty.
XL1_IMAGE=xl1:local

# --- identity ---------------------------------------------------------------

# How this node is identified and labelled on the status page.
NODE_ID=node-01
NODE_LABEL="My XL1 Node"
NODE_ROLE=producer
NODE_NETWORK=sequence

# --- optional ---------------------------------------------------------------

# Pin the container by exact name. Leave empty to auto-discover by image tag,
# which survives the random names `docker run` assigns without --name.
XL1_CONTAINER=

XL1_HEALTH_PORT=9099

# Only set this if you have published the health port to loopback
# (docker run -p 127.0.0.1:9099:9099). Left empty, the agent reads health
# through `docker exec` and needs no published ports at all.
XL1_HEALTH_URL=

# A service that can answer /block-height by reading the chain through the XL1
# SDK. Not included in this repository -- see "block production counts" in the
# README. Leave empty and the agent simply reports no production figures.
XL1_HEIGHT_URL=

# Seconds between heartbeats. The receiver marks a node OFFLINE after three
# missed beats, so raising this makes an outage take longer to notice.
HEARTBEAT_INTERVAL=30
