[Unit]
Description=XL1 node heartbeat agent
Documentation=https://github.com/XYOracleNetwork/xl1-docker-images
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/xl1-heartbeat.env
ExecStart=/usr/bin/python3 /opt/xl1-heartbeat/xl1_heartbeat.py
Restart=always
RestartSec=15

# The agent only reads Docker state and /proc -- it never needs root.
# The 'docker' group is required for the Docker socket.
User=xl1agent
Group=docker
# vcgencmd reads the board's undervoltage and throttling flags through
# /dev/vchiq, which is root:video 0660 -- so without this the agent gets
# "Can't open device file" and the panel has nothing to show for power or
# clock on a machine that can perfectly well answer.
#
# Granted here rather than by adding xl1agent to the group permanently: the
# service gets it, nothing else that user might run does, and the reason is
# written next to the grant instead of living in /etc/group where it has none.
#
# It is read-only use of a GPU mailbox on a headless node. Worth stating
# because it is a real widening: `video` also reaches the framebuffer and DRI
# devices, which this agent never touches.
SupplementaryGroups=video

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectSystem=strict makes everything read-only except what is granted back.
# Without this the agent can anchor an attestation and then fail to save the
# payload -- gas spent, and the only copy of what that transaction committed to
# unwritable. StateDirectory creates it owned by User= and writable, without
# opening any path the agent has no business writing to.
StateDirectory=xl1-heartbeat
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
