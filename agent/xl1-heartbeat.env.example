# Agent configuration — copy to /etc/xl1-heartbeat.env on the Pi
#
#   sudo cp xl1-heartbeat.env.example /etc/xl1-heartbeat.env
#   sudo nano /etc/xl1-heartbeat.env
#   sudo chmod 600 /etc/xl1-heartbeat.env
#
# This file holds the ingest secret. It is NOT the XL1 mnemonic — the agent
# never reads, needs, or transmits your wallet phrase.
#
# TWO RULES THAT WILL BITE YOU
#
# 1. Setting a variable to nothing is NOT the same as leaving it out.
#    `XL1_HEIGHT_URL=` overrides the default with an empty string and switches
#    that feature off. To get the default, delete or comment out the line.
#    Everything optional below is therefore commented out, not blanked — the
#    handful set to empty on purpose say so.
#
# 2. Quote any value containing spaces. systemd's EnvironmentFile does not
#    need the quotes, but anything that sources this file with `.` does, and
#    an unquoted `NODE_LABEL=Raspberry Pi` makes the shell try to run `Pi`.
#
# A working file can be as short as the required section. That is the normal
# case, not a cut-down one.

# --- required ----------------------------------------------------------------

# Your backend. No trailing slash. The ingest token travels with every request,
# so this must be https for anything leaving the local network.
BACKEND_URL=https://your-backend.onrender.com

# Must match NODE_HEARTBEAT_TOKEN in the backend's environment, exactly.
# Generate your own — 64 hex characters:
#
#   openssl rand -hex 32
NODE_HEARTBEAT_TOKEN=CHANGE-ME-generate-with-openssl-rand-hex-32

# --- identity (recommended) ---------------------------------------------------
# Defaults work, but every node then reports as the same thing, which gets
# confusing the moment you run two. NODE_ID defaults to the hostname.

NODE_ID=shed-pi-01
NODE_LABEL="Raspberry Pi"
NODE_ROLE=producer
NODE_NETWORK=sequence

# --- everything below is optional ---------------------------------------------
# Each is shown with the value the agent uses when the line is absent.
# Uncomment only what you actually want to change.

# --- container discovery ------------------------------------------------------

# The image tag your node runs, as `docker ps` reports it. This is how the
# container is found when XL1_CONTAINER is not set.
# XL1_IMAGE=xl1:local

# Pin the container by exact name instead of discovering it by image tag.
# Empty is a genuine setting here: it means "discover it".
XL1_CONTAINER=

# Substring of the node's entrypoint command, used as a last-resort way to
# identify the container when the image tag no longer matches — which happens
# during an image promotion, while the old tag is briefly gone.
# XL1_COMMAND_HINT=/opt/xl1/

# --- health -------------------------------------------------------------------

# Where the node serves health inside the container.
# XL1_HEALTH_PORT=9099

# Set ONLY if you published the health port to the host
# (docker run -p 127.0.0.1:9099:9099). Left unset, the agent reads health
# through `docker exec` and needs no published ports at all.
# XL1_HEALTH_URL=http://127.0.0.1:9099/livez

# --- timing -------------------------------------------------------------------

# Seconds between heartbeats. The backend marks a node OFFLINE after three
# missed beats, so raising this makes an outage take longer to notice.
# HEARTBEAT_INTERVAL=30

# Seconds to wait for the backend to answer. Generous on purpose: a free-tier
# host that has spun down can take 30-60s to wake.
# HEARTBEAT_TIMEOUT=60

# --- chain height (optional) --------------------------------------------------
#
# These point at a local xl1-service. If you run one, they work with no
# configuration. Setting them empty switches the feature OFF.

# XL1_HEIGHT_URL=http://127.0.0.1:8090/block-height
# XL1_HEIGHT_NETWORKS=sequence,mainnet

# --- block production counts (optional) ---------------------------------------

# XL1_PRODUCER_URL=http://127.0.0.1:8090/producer

# Seconds between production scans. Scanning is the expensive call, so it runs
# far less often than the heartbeat.
# XL1_PRODUCER_INTERVAL=900

# Blocks to scan on the very first run, before a cursor exists.
# XL1_PRODUCER_WINDOW=200

# Blocks per history chunk, walking backwards toward genesis. Set 0 to disable
# backfill and count only from today onward.
# XL1_BACKFILL_CHUNK=50000

# The address whose blocks are counted. Normally leave this out: the agent
# reads it from the running container's environment. Set it only if that
# discovery fails. Forty hex characters, with or without a 0x prefix.
# XL1_REWARD_ADDRESS=

# --- staying current ----------------------------------------------------------
#
# Two independent things drift, and neither can stand in for the other:
# the CLI *inside* the image, and the repository the image is *built from*.
# A fix to the Dockerfile or a role preset moves the second and leaves the
# first untouched.

# Where to look up the newest published CLI version. Setting this empty
# switches version checking off completely — both the lookup and the read from
# the container. That read is a `docker exec`, so turning it off (together with
# XL1_HEALTH_URL above) leaves the agent making only read-only Docker calls.
# XL1_CLI_REGISTRY=https://registry.npmjs.org/@xyo-network/xl1-cli/latest

# Seconds between version checks. Four times a day is plenty for something
# that changes every few weeks. Shared with the SDK check below.
# XL1_CLI_CHECK_INTERVAL=21600

# The CLI settings above cover the node container. These cover the SDK the
# companion service reads the chain WITH, which is the more consequential of
# the two: that service decodes blocks, payloads and mint transfers, so a
# protocol change met by a library too old to understand it does not raise an
# error — it puts a plausible wrong number on an earnings panel.
#
# The version is asked for over HTTP rather than read by `docker exec`, so
# enabling it costs no additional Docker privilege. Set either empty to switch
# the check off; a local version with nothing to compare it against is not
# useful, so both halves go together.
# XL1_VERSIONS_URL=http://127.0.0.1:8090/versions
# XL1_SDK_REGISTRY=https://registry.npmjs.org/@xyo-network/xl1-sdk/latest

# Attestation. The node anchors a hash of its own readings to the chain so a
# visitor can tell they have not been edited since — the hardware figures on the
# panel are otherwise just the machine describing itself, and nothing stops a
# description being revised after the fact.
#
# Off unless XL1_ATTEST_URL is set, and the service refuses to sign without its
# own key and anchor token, so enabling this by accident cannot start spending
# gas. Each attestation is a transaction: the interval is a cost, not a
# preference.
# XL1_ATTEST_URL=http://127.0.0.1:8090/attest

# The same token the service is configured with. It refuses to sign for an
# unauthenticated caller — correctly, since a signing key behind an open
# endpoint is worse than no signing — so without this the agent is turned away
# with a 401 on every attempt.
# XL1_ANCHOR_TOKEN=the-value-the-service-uses

# Seconds between attestations. Hourly is enough to make a readable history
# without anchoring more often than anything changes.
# XL1_ATTEST_INTERVAL=3600

# Where an anchored attestation is written BEFORE the backend is told. The
# chain stores only a hash and will not serve the payload back, so between
# anchoring and storing this directory holds the only copy in existence.
# Anything still here is retried on every slow cycle.
# XL1_ATTEST_SPOOL=/var/lib/xl1-heartbeat/attestations

# Your local clone of the image recipe, compared against upstream's head. The
# agent reads .git directly rather than running git, so it needs no write
# access and does not trip git's dubious-ownership refusal.
# XL1_IMAGES_REPO=/opt/xl1-docker-images
# XL1_IMAGES_REPO_API=https://api.github.com/repos/XYOracleNetwork/xl1-docker-images
# XL1_IMAGES_REPO_BRANCH=main

# --- supervision (optional) ---------------------------------------------------
#
# Reported so the update email can say when a rebuild will actually happen, and
# name the right thing to restart, instead of asserting either. Set empty to
# skip the lookup.

# The timer that rebuilds the node image, if you installed one.
# XL1_REBUILD_TIMER=xl1-image-rebuild.timer

# The systemd unit managing the producer container, if one does. When this is
# active the update mail tells you to restart the unit; when it is not, it
# tells you to recreate the container by hand.
# XL1_PRODUCER_UNIT=xl1-producer.service

# --- eligibility and logs (optional) ------------------------------------------
#
# Whether the node can actually produce, and what it last said. Stake is not
# readable from the XL1 gateway — it lives on Ethereum Sepolia — so eligibility
# is inferred from the balance and from the node's own verdict in its logs.

# The companion service that reads the reward address balance. This is the
# xl1-service in this repo, running on the same machine and bound to loopback:
# it holds the gateway SDK, which the stdlib-only agent deliberately does not.
# NOT dead weight — switching it off blanks the balance tile and makes the
# agent report producer_balance as a failing reader. Set empty to skip.
# XL1_STANDING_URL=http://127.0.0.1:8090/standing
#
# The ticker shown beside the balance comes from this service's reply, not
# from the dashboard: neither the SDK nor the explorer exposes one, and a
# number on an operator panel with no unit beside it is not a balance. An
# older service that does not send it leaves the figure unlabelled rather
# than having the panel invent a symbol.

# Seconds between balance lookups. A balance changes slowly and a heartbeat
# must never wait on it, so this is far longer than the heartbeat interval.
# XL1_STANDING_INTERVAL=900

# What one anchor costs, measured on the chain from the anchoring wallet's own
# recent transfers. Same service, same cadence as the balance above.
#
# It exists because the alternative is guessing, and both earlier guesses were
# wrong in ways that mattered: a hand-measured constant that ages, and a figure
# derived from an assumed starting balance, which reports an infinite runway
# the moment a wallet is topped up — precisely when the operator is looking.
# Switching it off costs the runway estimate and nothing else; the balance and
# the address keep working. Set empty to skip.
# XL1_ANCHOR_COST_URL=http://127.0.0.1:8090/anchor-cost

# Whether an anchor this node recorded actually reached the chain.
#
# The panels list anchors out of the site's own records — what this system says
# it did. The rows carry real transaction hashes and link to the explorer, but
# nothing ever went and looked. This node is the only party that can: the
# gateway SDK lives in the companion service on loopback, and neither the
# backend nor a browser can reach a chain client.
#
# The check worth having is the failing one — an anchor recorded as done that
# never landed. A confirmed one is not proof of anything and the panel does not
# badge it: a "yes" here is this node's own word, relayed.
# XL1_TX_CHECK_URL=http://127.0.0.1:8090/transaction

# How many anchors to check per slow cycle. There is no deadline, and this
# shares a Pi with a block producer.
# XL1_TX_CHECK_BATCH=5

# How far back to grep the container log for the node's own reason it cannot
# produce ("insufficient stake", "has no balance"). Long enough to survive a
# quiet period, short enough that a resolved problem stops being reported.
# XL1_ELIGIBILITY_WINDOW=20m

# How many log lines to show on the operator panel. The agent over-fetches and
# trims, so blank lines in the output do not shrink the count below this.
# XL1_LOG_TAIL_LINES=20

# How long the node takes to build a block, read from the lines it prints
# about generating each block's payload. The only leading indicator here:
# blocks produced and share both report a decline that has already
# happened, while build time climbs before races start being lost.
# XL1_BUILD_WINDOW=60m

# What counts as a build worth flagging. Deliberately well under the block
# interval -- the moment to look is while builds are trending toward it,
# not once they have passed it and the node is already losing.
# XL1_BUILD_BUDGET_MS=1000

# How many of the most recent samples to weigh, so a busy hour cannot make
# this unbounded.
# XL1_BUILD_SAMPLES_MAX=500

# Where the address this node signs blocks with is remembered once learned.
# It is read from the node's own eligibility line, which a staked node
# stops printing -- so forgetting it would quietly revert block counting to
# the reward address, which is only the same wallet on the common setup.
# XL1_PRODUCER_ADDR_FILE=/var/lib/xl1-heartbeat/producer-address

# Seconds between host package-update checks. This shells out to apt and the
# answer changes daily at most, so it runs far slower than the heartbeat. Set
# to 0 to switch the check off entirely — the agent then reports nothing about
# host packages rather than reporting zero, which are different claims.
# XL1_OS_UPDATE_INTERVAL=21600

# --- peer context (optional) --------------------------------------------------
#
# How this node's block share compares with the rest of the producing field. A
# block count alone cannot tell you whether a quiet day is your fault: the same
# number is healthy against three other producers and alarming against ten.

# The companion service endpoint that scans a window of blocks and reports who
# signed them. Set empty to skip. Only aggregates leave this machine — the
# other producers' addresses stay here.
# XL1_PEERS_URL=http://127.0.0.1:8090/peers

# How many blocks to scan. One RPC call regardless of size, so this is chosen
# for signal rather than cost: at roughly three blocks a minute, 1000 is about
# five hours, enough that a small share still lands well above sampling noise.
# A 40-block sample once suggested this node took 2.5% of blocks; 1000 blocks
# put it at 14.7%.
# XL1_PEERS_WINDOW=1000

# Seconds between peer scans. The field changes slowly.
# XL1_PEERS_INTERVAL=3600

# Seconds between background collector cycles. The expensive readers -- the
# production scan, the peer scan, the balance, apt -- run on a worker thread so
# the heartbeat never waits on them. Before this they ran inline, and a single
# slow scan could delay the beat past the backend's 90-second staleness
# threshold, declaring a perfectly healthy node OFFLINE and emailing about it.
# XL1_SLOW_CYCLE=60

# How often to re-read host packages while something is pending. The slow
# interval above is right for the usual case of nothing to report; this one
# takes over once updates are waiting, so a host that has just been patched
# says so within minutes rather than at the end of a six-hour cache — and the
# resolved email arrives without anyone restarting the agent to force it.
# XL1_OS_PENDING_INTERVAL=900

# What the node earned by PRODUCING, which is not the same as its balance: the
# balance also moves when the operator funds the node or transfers anything
# out. The service separates them by looking at what was minted. Blank to skip.
XL1_EARNINGS_URL=http://127.0.0.1:8090/earnings
# Seconds between reads. Two RPC calls answering a slowly-changing question.
XL1_EARNINGS_INTERVAL=900

# Blocks per chunk of the backward walk that collects earnings history.
# Deliberately smaller than XL1_BACKFILL_CHUNK: counting blocks tests one field
# per block, while counting mints reads every payload in every block, and the
# larger range did not finish inside the request timeout on a Pi. A request
# that times out leaves the cursor where it was, so the walk reports 0% for
# good rather than simply going slowly.
XL1_MINTED_CHUNK=5000

# --- Where this device says it is -------------------------------------------
#
# Entirely optional, and unset by default. Leave these blank and the device
# reports no location at all and appears on no map, which is the right default
# for hardware that mostly lives in somebody's house.
#
# Nothing verifies any of it. The receiver treats it as a claim by the
# operator, names the fields so nothing can render it as a measurement, and
# rounds the coordinates to one decimal place (~11 km) as they arrive -- a
# precise fix is never stored. Send a coarse one regardless: the rounding is a
# backstop, not permission.
#
# A town, a region, or a country. Whatever you are comfortable publishing.
XL1_STATED_LOCATION=

# Coordinates for map placement. One or two decimals is plenty -- anything
# finer is discarded on arrival. Out-of-range values are ignored rather than
# clamped, so a typo leaves you off the map instead of somewhere you did not
# choose.
XL1_STATED_LAT=
XL1_STATED_LON=

# How wide the location claim is, in kilometres. Defaults to 25, which suits a
# coordinate filled in from an IP lookup -- city-level IP geolocation is
# commonly tens of kilometres out and sometimes wrong about the country. The
# receiver will not accept anything under 11 km, because that is the precision
# it rounds to anyway. The map draws this as an area, not a pin.
XL1_STATED_RADIUS_KM=25

# --- Witnessing another device ----------------------------------------------
#
# Optional. Devices here accept no inbound connections, so one cannot reach out
# and contact another. What it can do is commit a peer's latest anchor hash
# inside its own anchor: the hash belongs to the peer and is already on chain,
# so anyone can check the reference points at something real and that this
# anchor came after it.
#
# What that does NOT prove is that the two devices belong to different people.
# One operator can run both ends. It is a record of mutual reference, never a
# reputation score, and the site says so.
#
# Leave blank to anchor without referencing anyone.
XL1_WITNESS_URL=
